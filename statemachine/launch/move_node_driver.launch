<?xml version="1.0"?>
<!-- Nodo de lanzamiento para el nodo de movimiento del robot Kinova -->
<launch>
    <node name="kinova_move"
          pkg="statemachine"
          type="move_node_api_kinova.py"
          output="screen">
        <param name="kinova_robotType" value="m1n6s300"/>
        <param name="unit" value="mq"/>
        <param name="verbose" value="false"/>
    </node>

    <node name="telemetryNode"
          pkg="statemachine"
          type="estado_actual.py"
          output="screen">
          <param name="kinova_robotType" value="m1n6s300"/>
    </node>
</launch>