<?xml version="1.0"?>
<launch>

  <arg name="py_path" default="python3"/>
  <arg name="use_simulation_params" default="true"/>

  <node name="segmentation_node"
        pkg="statemachine"
        type="segmentation_node_gazebo.py"
        output="screen"
        launch-prefix="$(arg py_path)">

    <rosparam if="$(arg use_simulation_params)"
              file="$(find statemachine)/config/simulation_params.yaml"
              command="load"/>
    <rosparam unless="$(arg use_simulation_params)"
              file="$(find statemachine)/config/robot_params.yaml"
              command="load"/>
  </node>

</launch>